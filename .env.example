# Configure production values through Sites runtime settings. Never commit secrets.
ADMIN_EMAILS=
# Choose a secure Power Automate/intake webhook OR the direct Dataverse adapter.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
DATAVERSE_URL=
# Optional mapping of supported source keys to your Dataverse custom column names.
CRM_FIELD_MAP={}

# NGETU commerce: Business Central Online (API v2.0).
# Provision a least-privilege Microsoft Entra application and authorise it in BC.
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_ENVIRONMENT=
BC_COMPANY_ID=
# Approved existing web customer; documents must use VAT-inclusive ZAR prices.
BC_WEB_CUSTOMER_ID=
# Required for nonzero delivery fees: approved BC delivery/service item GUID.
BC_SHIPPING_ITEM_ID=

# Provisional Payfast adapter; client must confirm their provider.
# Set credentials using runtime secrets. Keep checkout disabled until tested.
PAYFAST_MODE=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Exact public HTTPS origin, no trailing slash, e.g. https://www.ngetu.co.za
COMMERCE_ORIGIN=
